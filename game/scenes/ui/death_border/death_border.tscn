[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

// Death Border vignette: the darkness closes in from the edges as the run risk grows.
uniform vec4 vignette_color : source_color = vec4(0.12, 0.0, 0.0, 1.0);
uniform float risk : hint_range(0.0, 1.0) = 0.0;
// Clear radius at minimum and maximum risk (0.5 = edge of the screen).
uniform float radius_low = 0.8;
uniform float radius_high = 0.35;
uniform float softness = 0.35;
uniform float max_alpha = 0.85;

void fragment() {
	float dist = length(UV - vec2(0.5));
	float radius = mix(radius_low, radius_high, risk);
	float shade = smoothstep(radius, radius + softness, dist);
	COLOR = vec4(vignette_color.rgb, shade * max_alpha * smoothstep(0.0, 0.15, risk));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = SubResource("Shader_vignette")
shader_parameter/vignette_color = Color(0.12, 0, 0, 1)
shader_parameter/risk = 0.0
