[sub_resource type="Shader" id="Shader_barrier_border"]
code = "shader_type canvas_item;

// Red edge glow shown while the barrier is open. HUD drives 'intensity' to pulse it.
uniform vec4 border_color : source_color = vec4(0.85, 0.2, 0.2, 1.0);
uniform float border_width : hint_range(0.0, 0.5) = 0.12;
uniform float intensity : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 edge = min(UV, 1.0 - UV);
	float dist = min(edge.x, edge.y);
	float alpha = 1.0 - smoothstep(0.0, border_width, dist);
	COLOR = vec4(border_color.rgb, border_color.a * alpha * alpha * intensity);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_barrier_border"]
shader = SubResource("Shader_barrier_border")
shader_parameter/border_color = Color(0.85, 0.2, 0.2, 1)
shader_parameter/border_width = 0.12
shader_parameter/intensity = 0.0

